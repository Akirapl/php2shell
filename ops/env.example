# php2shell — environment variable NAMES used by the pipeline. No values here, ever.
# Copy to a private file outside the repo (e.g. ~/.config/php2shell.env, chmod 600) and fill in there.
# Nothing in the public repo needs any of these: ops/verify_handover.sh and checker tests run without them.

# --- GitHub (publish_pages.sh, box-only; used by the meldunki routine via site/update_and_build.sh)
# Fine-grained PAT, repository Akirapl/php2shell only.
#   Contents: read & write   -> push gh-pages (built site) and main (data/facts.json)
#   Pages: read & write      -> only for site/enable_pages.sh (one-off)
#   Administration: write    -> NOT granted today; needed to set repo homepage/topics (owner does it in the UI)
#   Workflows: write         -> NOT known to be granted; needed to push files under .github/workflows/
# Passed to git only through an in-memory http.extraheader (GIT_CONFIG_* env); never in a remote URL or .git/config.
GITHUB_PAGES_TOKEN=

# --- publish_pages.sh overrides (optional)
PAGES_REPO_URL=          # default https://github.com/Akirapl/php2shell.git (override only for local tests)
PAGES_WORK=              # default /workspace/php-incident/pages-repo (temporary clones; do not touch while the routine runs)

# --- site/update_and_build.sh (optional)
RELAXED=                 # 1 = a missing language is a warning (sources stay mandatory)

# --- Surge redirect (staging/surge-redirect/deploy_redirect.sh sources /workspace/php-incident/.surge-credentials)
SURGE_LOGIN=
SURGE_TOKEN=
# SURGE_PASSWORD also exists in that file; the CLI only needs LOGIN + TOKEN.

# --- Render (dashboard only; no API key is used anywhere). Stored in /workspace/php-incident/.render-credentials as:
# RENDER_EMAIL=   RENDER_PASSWORD=     (account that owns service php2shell-checker)

# --- checker-api runtime
CHECKER_RESOLVER=        # system (container default) | auto (box: falls back to DoH when DNS returns 198.18/15 fake IPs) | doh
PORT=                    # set by Render; Dockerfile defaults to 8080

# --- case-study renderer (bible/build/render-mmd.mjs; box-only)
CHROME=                  # default /usr/bin/google-chrome (html-to-pdf.mjs hard-codes that path)

# --- ops/verify_handover.sh
VENV=                    # default ${TMPDIR:-/tmp}/php2shell-verify-venv
P2S_BOX=                 # default /workspace/php-incident (owner box incident root)
