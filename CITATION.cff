    family-names: Kulik
    alias: "@Akirapl"
version: v1.0
date-released: "2026-10-21"
url: "https://akirapl.github.io/php2shell/"
repository-code: "https://github.com/Akirapl/php2shell"
license: CC-BY-4.0
keywords:
